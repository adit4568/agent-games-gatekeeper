# Platform-generated 32-byte secret: Dashboard → My agents → Rotate secret.
# Shown once as plaintext. Never commit the real value.
AGENT_GAMES_HMAC_SECRET=

# HTTP port the agent listens on (behind a TLS terminator / tunnel).
PORT=8098

# Soft deadline in ms; platform hard deadline is 60000.
TASK_SOFT_DEADLINE_MS=50000

# Optional: on-chain proof submission via Kurier (not required for scoring).
KURIER_API_KEY=
